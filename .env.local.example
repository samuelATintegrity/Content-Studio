# Copy to .env.local (for local dev) and fill in real values.
# In production (Vercel/Railway), set these as host environment variables.

# ─── Vercel (Next.js app) ─────────────────────────────────────────────────

# Pexels (free): https://www.pexels.com/api/
PEXELS_API_KEY=

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# fal.ai (Nano Banana 2 image generation): https://fal.ai/dashboard
FAL_API_KEY=

# Password gate. Required in production; leave blank for local dev to skip.
APP_PASSWORD=

# ─── Video workflow (Vercel side) ─────────────────────────────────────────

# Railway worker URL (the Fastify service that runs ffmpeg).
# e.g. https://content-studio-worker-production.up.railway.app
RAILWAY_WORKER_URL=

# Shared secret between Vercel and the Railway worker. 32+ random chars.
# Same value must also be set in the Railway service's env.
RAILWAY_API_SHARED_SECRET=

# ─── Worker-side env vars (for reference; not used by the Next.js app) ────
# These belong in the Railway service environment, not Vercel. Listed here
# so you have one canonical place to track every key the project uses.
#
# ELEVENLABS_API_KEY           — TTS API key
# ELEVENLABS_VOICE_ID_EN       — multilingual voice for English narration
# ELEVENLABS_VOICE_ID_TL       — voice for Tagalog
# ELEVENLABS_VOICE_ID_ES       — voice for Spanish
# ELEVENLABS_VOICE_ID_ZH       — voice for Mandarin
# PEXELS_API_KEY               — same key as Vercel
# R2_ACCESS_KEY                — Cloudflare R2 access key
# R2_SECRET                    — Cloudflare R2 secret key
# R2_ENDPOINT                  — https://<account>.r2.cloudflarestorage.com
# R2_BUCKET                    — content-studio-videos
# R2_PUBLIC_URL                — https://pub-xxx.r2.dev (or custom domain)
# RAILWAY_API_SHARED_SECRET    — same value as Vercel
