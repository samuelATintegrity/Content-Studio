# Copy to .env.local (for local dev) and fill in real values.
# In production (Vercel/Railway/etc), set these as host environment variables.

# Pexels (free): https://www.pexels.com/api/
PEXELS_API_KEY=

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# fal.ai (Nano Banana 2): https://fal.ai/dashboard
FAL_API_KEY=

# Password gate. Required in production; leave blank for local dev to skip.
# When set, anyone visiting the URL is prompted by the browser. Username is
# ignored; only the password is checked. Pick something hard to guess.
APP_PASSWORD=
